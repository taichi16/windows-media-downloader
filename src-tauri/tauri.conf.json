{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows 影音下載工具",
  "version": "1.0.0",
  "identifier": "tw.yt-music-downloader.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Windows 影音下載工具",
        "width": 1080,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [],
    "resources": [
      "resources/bin/*",
      "resources/licenses/*",
      "resources/sidecar-manifest.json*"
    ]
  }
}
